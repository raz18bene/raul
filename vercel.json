{
    "buildCommand": "echo 'No build needed'",
    "outputDirectory": ".",
    "installCommand": "npm install",
    "framework": null,
    "functions": {
      "api/**/*.js": {
        "memory": 1024,
        "maxDuration": 60
      }
    },
    "rewrites": [
      {
        "source": "/(.*)",
        "destination": "/$1"
      }
    ]
  }